    {
      "name": "11 - Select Existing Destination",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/accounts?currency=CAD&status=Active"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => { pm.response.to.have.status(200); });",
              "const a=pm.response.json();pm.test('Account listing is array',()=>pm.expect(a).to.be.an('array'));const d=a.find(x=>x.accountId!==pm.collectionVariables.get('sourceId')&&x.currency==='CAD'&&x.status==='Active'&&Number.isSafeInteger(x.balanceMinor)&&x.balanceMinor<Number.MAX_SAFE_INTEGER-100);pm.test('Eligible destination exists',()=>pm.expect(d).to.exist);if(d){pm.collectionVariables.set('destinationId',d.accountId);pm.collectionVariables.set('destinationBefore',String(d.balanceMinor));}"
            ]
          }
        }
      ]
