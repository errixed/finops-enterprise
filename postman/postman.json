    {
      "name": "05 - Create Client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clients",
        "body": {
          "mode": "raw",
          "raw": "{\"companyName\":\"FinOps Postman Test Company\",\"registrationNumber\":\"{{registrationNumber}}\",\"industry\":\"Technology\",\"country\":\"Canada\",\"contactEmail\":\"finops-test@example.com\",\"contactPhone\":\"4165550100\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('registrationNumber','PM-'+Date.now()+'-'+Math.floor(Math.random()*100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => { pm.response.to.have.status(201); });",
              "const b=pm.response.json();pm.test('Save client ID',()=>{pm.expect(b.clientId).to.be.a('string');pm.collectionVariables.set('clientId',b.clientId);});"
            ]
          }
        }
      ]
